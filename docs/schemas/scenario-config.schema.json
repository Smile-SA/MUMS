{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/benchmark-platform/docs/schemas/scenario-config.schema.json",
  "title": "Benchmark Platform Scenario Config — version 1 envelope",
  "description": "Validates only the framework-level envelope: top-level sections, and per-component `type`/`module`. Per-module fields (e.g. traffic.shape) are opaque here and validated by each module's own args: schema instead (see writing-a-module.md).",
  "type": "object",
  "required": [
    "version",
    "scenario",
    "environment",
    "stack",
    "observability",
    "traffic",
    "optimizer",
    "output"
  ],
  "properties": {
    "version": {
      "const": 1,
      "description": "Frozen. Breaking changes bump this value; version 1 only ever grows additively."
    },
    "scenario": {
      "type": "object",
      "required": ["name", "seed", "duration_seconds"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 1 },
        "duration_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "environment": { "$ref": "#/$defs/component" },
    "stack": { "$ref": "#/$defs/component" },
    "observability": { "$ref": "#/$defs/component" },
    "traffic": { "$ref": "#/$defs/component" },
    "optimizer": { "$ref": "#/$defs/component" },
    "dataset": { "$ref": "#/$defs/component" },
    "output": {
      "type": "object",
      "required": ["root_directory"],
      "properties": {
        "root_directory": { "type": "string", "minLength": 1 },
        "cleanup_environment": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "description": "Envelope shape shared by every component section. Additional module-specific keys are allowed and are opaque to this schema.",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
